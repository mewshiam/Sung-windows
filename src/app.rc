// Windows resource script for Sung. The icon is what Explorer, the taskbar
// and the Start menu show; the version block is what the Properties dialog
// and installers read. RC files are compiled by rc.exe (MSVC) and windres
// (MinGW) alike, and both resolve paths relative to this file. winres.h
// carries the VOS_ and VFT_ constants the version block below uses.
#include <winres.h>

// Explorer, Task Manager and the tray balloon (MAKEINTRESOURCEW(1)) read the
// first group icon; it keeps the numeric id 1.
1 ICON "../assets/sung.ico"

// Qt registers every window class with the icon it finds in the exe under
// the STRING name "IDI_ICON1" - an identifier the script leaves undefined,
// which is how Qt's own qtmain.rc declares it. Any window without an icon of
// its own (the mini player, message boxes) falls back to that class icon in
// the taskbar, so the resource must exist under exactly that name. The
// define this file used to carry turned the name into numeric id 1, the
// lookup missed, and the taskbar showed the generic application icon instead.
#ifdef IDI_ICON1
#undef IDI_ICON1
#endif
IDI_ICON1 ICON "../assets/sung.ico"

#define VER_FILEVERSION             0,1,6,0
#define VER_FILEVERSION_STR         "0.1.6\0"
#define VER_PRODUCTVERSION          0,1,6,0
#define VER_PRODUCTVERSION_STR      "0.1.6\0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Sung"
            VALUE "FileDescription",  "Sung - YouTube Music, your music files, and your music server"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "sung"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "sung.exe"
            VALUE "ProductName",      "Sung"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
